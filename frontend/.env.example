# Copy to .env — Expo only exposes vars prefixed with EXPO_PUBLIC_ to the app.

# Base URL of the Kabar Pasar FastAPI backend.
# Simulator / web: localhost works.
# Physical device: use your dev machine's LAN IP (not localhost), e.g.
#   EXPO_PUBLIC_API_URL=http://192.168.1.10:8000
EXPO_PUBLIC_API_URL=http://localhost:8000

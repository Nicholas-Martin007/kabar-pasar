# Copy to .env and fill in values
APP_ENV=development
LOG_LEVEL=INFO

# CORS — add your Expo dev URL if needed
ALLOWED_ORIGINS=http://localhost:8081,http://localhost:19006,exp://localhost:8081

# Anthropic — required for AI summarization
# Get your key at https://console.anthropic.com
ANTHROPIC_API_KEY=

# How many NEW items per refresh cycle get AI bullets (cost control)
AI_SUMMARY_BATCH=10

# Background refresh interval in minutes
REFRESH_INTERVAL_MIN=5

# Telegram bot for free watchlist alerts (optional).
# Create a bot via @BotFather in Telegram, paste the token here. Leave empty
# to disable. Users then DM your bot: /start, /watch BBCA, /list, /stop
TELEGRAM_BOT_TOKEN=

# Hour (WIB, 0-23) to send the daily Telegram digest. Default 17 (after close).
DIGEST_HOUR_WIB=17

# TESTING ONLY: push one REAL cached news item to Telegram every N seconds
# (rotating through the latest 50), so you can see news arriving without waiting
# for genuinely-new articles. Set e.g. 5 to test, then set back to 0.
TEST_ALERT_SECONDS=0

# Persistence — leave unset for local SQLite at backend/data/kabar_pasar.db
# Production example:
# DATABASE_URL=postgresql+asyncpg://user:pw@host:5432/kabar_pasar
DATABASE_URL=

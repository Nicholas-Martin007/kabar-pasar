# Copy to .env and fill in values
APP_ENV=development
LOG_LEVEL=INFO

# CORS — add your Expo dev URL if needed
ALLOWED_ORIGINS=http://localhost:8081,http://localhost:19006,exp://localhost:8081

# Anthropic — required for AI summarization
# Get your key at https://console.anthropic.com
ANTHROPIC_API_KEY=

# How many items per /news request get AI bullets (default 10)
AI_SUMMARY_BATCH=10
